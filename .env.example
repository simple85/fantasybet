# API-Football key (https://dashboard.api-football.com/). Leave empty to run with mock data.
API_FOOTBALL_KEY=
# Requests per day on your plan (free: 100). Below 30000 the server runs in budget mode (see README).
API_FOOTBALL_DAILY_LIMIT=100
# Optional: requests per minute (free: 10) and followed league ids in budget mode
API_FOOTBALL_PER_MINUTE=
API_FOOTBALL_LEAGUES=

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fantasybet

# Admin panel login (admin login is disabled while ADMIN_PASSWORD is empty)
ADMIN_ID=admin
ADMIN_PASSWORD=change-me

# Signs login session cookies — required in production (openssl rand -hex 32)
SESSION_SECRET=

# AI bet builder (Gemini API key from aistudio.google.com). Without it the builder says it isn't set up.
GEMINI_API_KEY=
# Optional: model (default gemini-3.6-flash) and model calls per user per day (default 40)
BET_BUILDER_MODEL=
BET_BUILDER_DAILY_LIMIT=

# Optional
PORT=8000
NODE_ENV=development
