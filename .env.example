# API-Football key (https://dashboard.api-football.com/). Leave empty to run with mock data.
API_FOOTBALL_KEY=

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fantasybet

# Admin panel login (admin login is disabled while ADMIN_PASSWORD is empty)
ADMIN_ID=admin
ADMIN_PASSWORD=change-me

# Signs login session cookies — required in production (openssl rand -hex 32)
SESSION_SECRET=

# Optional
PORT=8000
NODE_ENV=development
